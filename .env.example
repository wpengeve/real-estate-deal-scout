# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# Anthropic — required for full Claude ranking (mock mode works without it)
ANTHROPIC_API_KEY=sk-ant-...

# Walk Score — optional, enriches listings with walkability scores
# Free key: https://www.walkscore.com/professional/api.php
WALKSCORE_API_KEY=

# HUD Fair Market Rents — optional, provides rent estimates when using Redfin data
# Free key (instant approval): https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=

# NREL Solar Resource API — optional, enriches listings with annual sun exposure (GHI kWh/m²/day)
# Free key (instant approval): https://developer.nrel.gov/signup/
NREL_API_KEY=

# ScraperAPI — structured Redfin listings (data_source: scraperapi)
# Free tier: 1,000 credits/month — https://www.scraperapi.com/
SCRAPERAPI_KEY=
SCRAPERAPI_CACHE_TTL_HOURS=24

# Google Maps Geocoding — resolves lat/lon from address (40k free calls/month)
# Get key: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_MAPS_KEY=

# Rentcast — live national sale listings (data_source: rentcast)
# Free tier: 50 calls/month — https://app.rentcast.io/app/login
# To activate: set data_source: rentcast in config.yaml
RENTCAST_API_KEY=

# Resend — delivers magic-link login emails (tools/email_sender.py).
# Free tier: 3,000/month — https://resend.com
# NOT WIRED IN YET: with or without this key, the link currently only prints to
# the server console. Sending also needs a verified domain; until you have one,
# Resend's shared onboarding address delivers to your OWN address only.
RESEND_API_KEY=
# Sender shown on the email, e.g. "Deal Scout <hello@yourdomain.com>".
# Defaults to Resend's shared onboarding address when unset.
EMAIL_FROM=

# ── Where state lives (deployment) ────────────────────────────────────────────
# Not keys. Leave all three blank for local use — the defaults are correct.
#
# Set them when deploying to a host with EPHEMERAL disk (Render/Fly/Railway free
# tiers wipe the filesystem on every redeploy). Point each at a mounted volume,
# or you will lose the thing named:

# Area-market slices — no key needed (free Redfin Data Center download).
# Defaults to data/. Regenerable: python scout.py --market-refresh WA
MARKET_TRENDS_DIR=

# The SQLite database: every user account, login session, and run record.
# Defaults to data/scout.db. NOT regenerable — losing it logs everyone out
# permanently and drops their report history.
SCOUT_DB_PATH=

# Generated HTML reports — what a shared /reports/{run_id} link resolves to.
# Defaults to outputs/. Losing them 404s every link already shared.
SCOUT_OUTPUTS_DIR=
