# Copy this file to .env and fill in your values
# Never commit .env to git

# Required: Anthropic API key for deal ranking and narrative generation
ANTHROPIC_API_KEY=sk-ant-...

# Required for enrichment: WalkScore API key
# Sign up at https://www.walkscore.com/professional/api.php
WALKSCORE_API_KEY=your_key_here

# Optional: future real data source (RapidAPI Zillow wrapper)
# RAPIDAPI_KEY=your_key_here
