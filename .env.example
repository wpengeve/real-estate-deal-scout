# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# Anthropic — required for full Claude ranking (mock mode works without it)
ANTHROPIC_API_KEY=sk-ant-...

# Walk Score — optional, enriches listings with walkability scores
# Free key: https://www.walkscore.com/professional/api.php
WALKSCORE_API_KEY=

# HUD Fair Market Rents — optional, provides rent estimates when using Redfin data
# Free key (instant approval): https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=

# NREL Solar Resource API — optional, enriches listings with annual sun exposure (GHI kWh/m²/day)
# Free key (instant approval): https://developer.nrel.gov/signup/
NREL_API_KEY=
