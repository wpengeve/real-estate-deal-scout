# Environment
.env
.env.local

# Your own settings — copy config.yaml.example to create it. Untracked so local
# edits don't show as a pending change, and a pull can't overwrite them.
config.yaml

# Personal progress log (local only, never committed)
PROGRESS.md

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/

# Pipeline outputs (local only)
outputs/

# Downloaded listing CSVs (real data, not for committing)
data/*.csv

# SQLite database (runtime data: users, sessions, run history)
data/*.db

# Area-market slices (regenerable: scout.py --market-refresh WA)
data/market_trends_*.tsv
data/market_trends_*.meta.json
# scratch file a killed refresh leaves behind — the *.tsv rule above only
# matches names ending in .tsv, so it never covered these
data/market_trends_*.partial

# Claude Code local settings
.claude/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/
.coverage
htmlcov/
.gstack/
data/scraperapi_cache/
